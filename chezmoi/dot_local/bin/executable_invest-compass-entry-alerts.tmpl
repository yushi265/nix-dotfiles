{{- if has .chezmoi.hostname .features.entry_alerts -}}
#!/bin/zsh -l
# invest-compass の買い場チェック（entry-alerts）を実行する。
# LaunchAgent（com.yushi265.invest-compass.entry-alerts）から平日 7:45 と 12:05 に起動される。
# 10時より前は朝（前営業日の確定日足）、それ以降は昼（前場の5分足の速報）として実行する。
# 条件が成立したら macOS に通知する（通知に銘柄は載せない）。
# 保有の有無を除いた *.public.md だけを invest-compass の main へ直接 push し、
# 「執事」プロジェクトの定期タスクがそれを読んでスレッドへ投稿する。
# LLM は使わない（CLI を直接実行する）。発注・保有DBの方針や設定は変更しない。
set -euo pipefail

repo="{{ .chezmoi.homeDir }}/src/github.com/yushi265/invest-compass"
cd "$repo"

phase=morning
if (( 10#$(date +%H) >= 10 )); then
  phase=midday
fi
echo "=== $(date '+%Y-%m-%d %H:%M:%S %z') entry-alerts $phase start"
rc=0
.venv/bin/python3 -m stock_investigator entry-alerts --phase "$phase" --notify \
  --database data/phase8-development.sqlite3 || rc=$?
echo "=== $(date '+%Y-%m-%d %H:%M:%S %z') entry-alerts $phase end (rc=$rc)"
# 終了コード1は一部の取得失敗。レポートはできているので投稿する。2は入力・設定エラー。
if (( rc == 2 )); then
  exit 2
fi

report="reports/entry-alerts/$(date +%F)-$phase.public.md"
if [[ ! -f "$report" ]]; then
  echo "publish: $report がないため push しない"
  exit "$rc"
fi
dest="$report"
blob="$(git hash-object -w "$report")"
# ローカルの作業ツリーと main には触れない（checkout や pull をすると作業中の変更とぶつかるので、
# 一時 index とプラミングコマンドで origin/main の上にコミットを作る）。
tmpdir="$(mktemp -d)"
# 途中で失敗しても一時 index を残さない。
trap 'rm -rf "$tmpdir"' EXIT
# fetch から push までの間に main が進むと fast-forward にならず弾かれる。
# 強制 push で他のコミットを消さないよう、取り直して作り直す。
for attempt in 1 2 3; do
  git fetch -q origin main
  parent="$(git rev-parse FETCH_HEAD)"
  rm -f "$tmpdir/index"
  GIT_INDEX_FILE="$tmpdir/index" git read-tree "$parent"
  GIT_INDEX_FILE="$tmpdir/index" git update-index --add --cacheinfo "100644,$blob,$dest"
  tree="$(GIT_INDEX_FILE="$tmpdir/index" git write-tree)"
  if [[ "$tree" == "$(git rev-parse "${parent}^{tree}")" ]]; then
    echo "publish: ${dest} は main に同じ内容があるため push しない"
    exit "$rc"
  fi
  commit="$(git commit-tree "$tree" -p "$parent" -m "entry-alerts: ${report:t}")"
  if git push -q origin "${commit}:refs/heads/main"; then
    echo "publish: ${dest} を main に push した ($commit)"
    exit "$rc"
  fi
  echo "publish: main が先に進んでいたため作り直す (${attempt}回目)"
done
echo "publish: main への push に3回失敗した" >&2
exit 1
{{ end -}}
