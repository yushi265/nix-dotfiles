{{- if has .chezmoi.hostname .features.market_report -}}
#!/bin/zsh -l
# invest-compass の /market-report（日本株の相場整理）を Claude Code で無人実行する。
# LaunchAgent（com.yushi265.invest-compass.market-report）から平日 8:10 に起動される。
# レポートは invest-compass の reports/market-report-YYYY-MM-DD.md に保存される。
# 作成後、レポートだけを invest-compass の main へ直接 push する。
# 「執事」プロジェクトの定期タスクがそれを読み、スレッドへ投稿する。
# レポートは公開情報の相場整理だけで、保有・予算・口座の情報は含まない。
set -euo pipefail

repo="{{ .chezmoi.homeDir }}/src/github.com/yushi265/invest-compass"
cd "$repo"

echo "=== $(date '+%Y-%m-%d %H:%M:%S %z') market-report start"
stamp="$(mktemp)"
# 調査・保存に要る操作だけを許可する。dontAsk なので、ここにない操作は確認なしで拒否される
# （settings.json の auto モードに任せない）。発注・push・保有DBの更新は許可しない。
# ファイル作成は Edit(path) ルールで判定される（Write(path) は効かない）。
"{{ .chezmoi.homeDir }}/.local/bin/claude" -p \
  "/market-report を実行して、レポートを reports/ に保存して。定期実行なので質問はせず、確認できない項目は未確認と書いて完了させて。" \
  --permission-mode dontAsk \
  --allowedTools \
    "Bash(.venv/bin/python3 -m stock_investigator market-snapshot:*)" \
    "Bash(.venv/bin/python3 -m stock_investigator v2-status:*)" \
    "Bash(date:*)" "Bash(ls:*)" "Bash(mkdir -p reports)" "Bash(git check-ignore:*)" \
    "WebSearch" "WebFetch" "Read" "Glob" "Grep" \
    "Edit(reports/**)"
echo "=== $(date '+%Y-%m-%d %H:%M:%S %z') market-report end"

# 今回作られたレポートを main へ直接 push する。ローカルの作業ツリーと main には触れない
# （checkout や pull をすると作業中の変更とぶつかるので、一時 index とプラミングコマンドで
# origin/main の上にコミットを作る）。
report="$(find reports -maxdepth 1 -name 'market-report-*.md' -newer "$stamp" -print | sort | tail -n 1)"
rm -f "$stamp"
if [[ -z "$report" ]]; then
  echo "publish: 新しいレポートがないため push しない"
  exit 0
fi
dest="reports/${report:t}"
blob="$(git hash-object -w "$report")"
tmpdir="$(mktemp -d)"
# 途中で失敗しても一時 index を残さない。
trap 'rm -rf "$tmpdir"' EXIT
# fetch から push までの間に main が進むと fast-forward にならず弾かれる。
# 強制 push で他のコミットを消さないよう、取り直して作り直す。
for attempt in 1 2 3; do
  git fetch -q origin main
  parent="$(git rev-parse FETCH_HEAD)"
  rm -f "$tmpdir/index"
  GIT_INDEX_FILE="$tmpdir/index" git read-tree "$parent"
  GIT_INDEX_FILE="$tmpdir/index" git update-index --add --cacheinfo "100644,$blob,$dest"
  tree="$(GIT_INDEX_FILE="$tmpdir/index" git write-tree)"
  if [[ "$tree" == "$(git rev-parse "${parent}^{tree}")" ]]; then
    echo "publish: ${dest} は main に同じ内容があるため push しない"
    exit 0
  fi
  commit="$(git commit-tree "$tree" -p "$parent" -m "market-report: ${report:t}")"
  if git push -q origin "${commit}:refs/heads/main"; then
    echo "publish: ${dest} を main に push した ($commit)"
    exit 0
  fi
  echo "publish: main が先に進んでいたため作り直す (${attempt}回目)"
done
echo "publish: main への push に3回失敗した" >&2
exit 1
{{ end -}}
