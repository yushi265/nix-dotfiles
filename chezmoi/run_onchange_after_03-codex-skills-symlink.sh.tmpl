#!/bin/bash
# Codex は ~/.agents/skills を直接読むため、旧Claude経由のミラーだけ整理する。
# ファイル名は既存環境の run_onchange 移行として維持する。リンクは新規作成しない。
# {{ glob (joinPath .chezmoi.sourceDir "dot_agents/skills/*/SKILL.md") | join "," | sha256sum }}
set -euo pipefail

# chezmoi の展開先を使う。一時ディレクトリを --destination に指定して検証可能。
migration_root={{ .chezmoi.destDir | quote }}

{{ range glob (joinPath .chezmoi.sourceDir "dot_agents/skills/*/SKILL.md") -}}
skill_name={{ base (dir .) | quote }}
canonical="$migration_root/.agents/skills/$skill_name"
legacy="$migration_root/.claude/skills/$skill_name"
mirror="$migration_root/.codex/skills/$skill_name"
# 同じ実体に到達する既知の旧ミラーだけ削除する。
# 実ディレクトリ、別のリンク先、管理外スキル、展開未完了のスキルは保持する。
if [ -L "$mirror" ] && [ "$(readlink "$mirror")" = "$legacy" ] &&
   [ -f "$canonical/SKILL.md" ] && [ "$legacy" -ef "$canonical" ]; then
  rm -- "$mirror"
fi
{{ end -}}
