[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	light = false
	line-numbers = true
	# side-by-side はここで有効にしないこと。[delta] セクションの直接指定は
	# features や環境変数より優先度が高く、delta は GIT_CONFIG_GLOBAL も
	# 無視するため、lazygit のような狭いペインだけ無効化する手段がなくなる。
	# 左右分割で見たいときは zsh の gds 関数を使う (--side-by-side を明示)。
	# herdr / nvim と系統を揃える
	syntax-theme = Catppuccin Mocha
	hunk-header-decoration-style = cyan box

[merge]
	conflictstyle = diff3

[diff]
	colorMoved = default

[ghq]
	root = ~/src
