{{- if has .chezmoi.hostname .features.entry_alerts -}}
#!/bin/bash
# entry-alerts の LaunchAgent を読み込み直す。plist が変わったときだけ再実行される。
# plist hash: {{ include "private_Library/LaunchAgents/com.yushi265.invest-compass.entry-alerts.plist.tmpl" | sha256sum }}
set -euo pipefail

label="com.yushi265.invest-compass.entry-alerts"
plist="$HOME/Library/LaunchAgents/$label.plist"
domain="gui/$(id -u)"

mkdir -p "$HOME/Library/Logs"
launchctl bootout "$domain/$label" 2>/dev/null || true
launchctl bootstrap "$domain" "$plist"
echo "loaded $label"
{{ end -}}
