#!/bin/bash
# スキル管理の再編 (自作=chezmoi / 外部=npx skills / 付属物あり=プラグイン) に伴い、
# 管理外のまま重複しているスキルを片付ける。再実行しても結果は変わらない。
#
# - AWS 独自インストーラが ~/.agents/skills と ~/.claude/skills に置いた実体コピー
#   (.aws-skill-metadata 付き)。AWS は Claude Code の aws-core プラグインで入れる。
# - ~/.codex/skills に置いた実体のうち、npx skills で ~/.agents/skills に入ったもの。
#   Codex は両方を読むため重複する。
# {{ .skills.external | toJson | sha256sum }}
set -euo pipefail
shopt -s nullglob

# chezmoi の展開先を使う。一時ディレクトリを --destination に指定して検証可能。
migration_root={{ .chezmoi.destDir | quote }}

for skill in "$migration_root/.agents/skills"/* "$migration_root/.claude/skills"/*; do
  if [ -d "$skill" ] && [ ! -L "$skill" ] && [ -f "$skill/.aws-skill-metadata" ]; then
    rm -rf -- "$skill"
  fi
done

remove_codex_copy() {
  local name copy
  for name in "$@"; do
    copy="$migration_root/.codex/skills/$name"
    if [ -d "$copy" ] && [ ! -L "$copy" ] &&
       [ -f "$migration_root/.agents/skills/$name/SKILL.md" ]; then
      rm -rf -- "$copy"
    fi
  done
}
{{ range .skills.external -}}
{{ if has "codex" (dig "agents" $.skills.defaultAgents .) -}}
remove_codex_copy{{ range .skills }} {{ . | quote }}{{ end }}
{{ end -}}
{{ end -}}
